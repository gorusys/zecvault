{
  "name": "zecvault",
  "version": "0.1.7",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @zecvault/web",
    "build": "npm run build -w @zecvault/web",
    "build:dev": "npm run build:dev -w @zecvault/web",
    "preview": "npm run preview -w @zecvault/web",
    "lint": "npm run lint -w @zecvault/web",
    "format": "prettier --write .",
    "dev:windows": "npm run dev -w @zecvault/windows",
    "dev:macos": "npm run dev -w @zecvault/macos",
    "dev:linux": "npm run dev -w @zecvault/linux",
    "build:win": "npm run build -w @zecvault/web && npm run tauri:build -w @zecvault/windows",
    "build:mac": "npm run build -w @zecvault/web && npm run tauri:build -w @zecvault/macos",
    "build:linux": "npm run build -w @zecvault/web && npm run tauri:build -w @zecvault/linux",
    "build:pwa": "npm run build -w @zecvault/pwa",
    "version:bump": "node scripts/bump-version.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@ziglang/cli": "^0.0.14",
    "cross-env": "^10.1.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1"
  },
  "optionalDependencies": {
    "@tauri-apps/cli-darwin-arm64": "^2.10.1",
    "@tauri-apps/cli-darwin-x64": "^2.10.1",
    "@tauri-apps/cli-win32-x64-msvc": "^2.10.1",
    "@tailwindcss/oxide-darwin-arm64": "^4.2.1",
    "@tailwindcss/oxide-darwin-x64": "^4.2.1",
    "@tailwindcss/oxide-win32-x64-msvc": "^4.2.1",
    "lightningcss-darwin-arm64": "^1.30.2",
    "lightningcss-darwin-x64": "^1.30.2",
    "lightningcss-win32-x64-msvc": "^1.30.2",
    "@rollup/rollup-darwin-arm64": "^4.52.4",
    "@rollup/rollup-darwin-x64": "^4.52.4",
    "@rollup/rollup-win32-x64-msvc": "^4.52.4"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": ["current", "win32", "linux", "darwin"],
      "cpu": ["current", "x64", "arm64"]
    }
  }
}
