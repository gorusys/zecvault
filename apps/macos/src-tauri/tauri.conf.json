{
  "$schema": "../../../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ZecVault",
  "version": "0.1.6",
  "identifier": "com.goru.zecvault",
  "build": {
    "frontendDist": "../../web/dist/client",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev -w @zecvault/web --prefix ../..",
    "beforeBuildCommand": "npm run build:desktop -w @zecvault/web --prefix ../.."
  },
  "app": {
    "windows": [
      {
        "title": "ZecVault",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#0D0D0B"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {}
  }
}
