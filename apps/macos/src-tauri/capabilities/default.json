{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:5173/*",
      "http://127.0.0.1:19876/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "permissions": [
    "core:default",
    "store:default",
    "log:default",
    "opener:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    "fs:allow-home-write",
    "fs:allow-home-read"
  ]
}
